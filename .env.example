# Copy to .env to change anything. With no .env at all, `docker compose up` gives the whole game.

# The key that switches the AI on: an Anthropic API key (https://console.anthropic.com/). Empty: the AI is off.
ANTHROPIC_API_KEY=

# The Claude model the coach asks, as Anthropic names it. On eval/coach (README) claude-haiku-5-5 names
# the mistake as often and costs less, but explains it less well than claude-sonnet-5-5.
KABBOUT_AI_MODEL=claude-sonnet-5-5

# Questions to the coach one visitor may ask in a minute (each one is a call to the model, on your key)
KABBOUT_COACH_LIMIT=6

# Questions one visitor may ask the coach about one deal.
KABBOUT_COACH_PER_DEAL=2

# The port the game is opened on: http://localhost:8080
KABBOUT_PORT=8080
