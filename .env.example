# Copy to .env to change anything. With no .env at all, `docker compose up` gives the whole game.

# The key that switches the AI on: an Anthropic API key (https://console.anthropic.com/). Empty: the AI is off.
ANTHROPIC_API_KEY=

# The Claude model the coach asks, as Anthropic names it. On eval/coach (README) claude-haiku-5-5 names
# the mistake as often and costs less, but explains it less well than claude-sonnet-5-5.
KABBOUT_AI_MODEL=claude-sonnet-5-5

# Questions to the coach one visitor may ask in a minute (each one is a call to the model, on your key)
KABBOUT_COACH_LIMIT=6

# Questions one visitor may ask the coach about one deal.
KABBOUT_COACH_PER_DEAL=2

# Questions all visitors together may ask the coach in a day: the most the key can be made to spend.
KABBOUT_COACH_DAILY=500

# New guests that may come in from one address in a minute. Every visitor without a cookie is a new
# guest, kept a month: this is what stops a script from filling the disk or taking every name.
KABBOUT_GUESTS_LIMIT=120

# The MCP server. Requests that may come from one address in a minute, and calls to its tables among
# them: each is work for the engine. A client playing a deal makes about fifteen.
KABBOUT_TABLES_LIMIT=300

# Tables one address may open on the MCP server in an hour. Each is kept a day.
KABBOUT_TABLES_OPENED=120

# Behind a reverse proxy: its address or range (comma separated), so that a visitor is the address it
# forwards and not the proxy itself. Leave empty when the server is reached directly.
KABBOUT_TRUSTED_PROXIES=

# The port the game is opened on: http://localhost:8080
KABBOUT_PORT=8080
