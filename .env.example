# Copy to .env to change anything. With no .env at all, `docker compose up` gives the whole game.

# The one variable that switches the AI on: <platform>://<key>@<provider>/<model>
#   platform  huggingface (Hugging Face Inference Providers)
#   key       your access token; if it holds @, / or %, write them percent-encoded (%40, %2F, %25)
#   provider  who runs the model (groq, together, nebius...), or auto to let the platform choose
#   model     as the platform names it
# Example: KABBOUT_AI=huggingface://hf_xxxxxxxx@auto/openai/gpt-oss-120b
KABBOUT_AI=

# The port the game is opened on: http://localhost:8080
KABBOUT_PORT=8080
