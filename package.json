{
  "name": "kabbout",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "bridge"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"engine/test/*.test.ts\" \"bridge/test/*.test.ts\" \"app/web/test/*.test.js\"",
    "test:golden:update": "UPDATE_GOLDEN=1 node --test engine/test/golden.test.ts",
    "build:web": "esbuild app/web/src/main.js --bundle --format=iife --target=es2020 --outfile=app/web/app.js --log-level=warning",
    "pretest:e2e": "npm run build:web",
    "test:coverage": "node scripts/run-coverage.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p engine && tsc -p bridge && tsc -p app/web && tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "conformity": "node scripts/check-conformity.mjs",
    "preserve": "npm run build:web",
    "serve": "node scripts/serve.mjs app/web 4173",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm run conformity && npm run test:coverage",
    "bench:robots": "node scripts/bench-robots.ts",
    "lint": "eslint .",
    "bridge": "node bridge/src/main.ts",
    "contract:record": "node bridge/scripts/record-contract.ts",
    "check:php": "node scripts/check-php.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "monocart-coverage-reports": "^3.2.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
