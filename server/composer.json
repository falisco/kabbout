{
    "name": "kabbout/server",
    "description": "The server side of Kabbout: the game and its API, with the rules engine reached through the bridge.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "mcp/sdk": "0.9.0",
        "nyholm/psr7": "^1.8",
        "symfony/ai-agent": "1.0.0-BETA1",
        "symfony/ai-anthropic-platform": "1.0.0-BETA1",
        "symfony/ai-bundle": "1.0.0-BETA1",
        "symfony/ai-generic-platform": "1.0.0-BETA1",
        "symfony/ai-platform": "1.0.0-BETA1",
        "symfony/clock": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mcp-bundle": "1.0.0-BETA1",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.2.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "autoload": {
        "psr-4": {
            "Kabbout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kabbout\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "php-http/discovery": false,
            "symfony/runtime": true
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "8.1.*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "runtime": {
            "disable_dotenv": true
        }
    }
}
