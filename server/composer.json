{
    "name": "kabbout/server",
    "description": "The server side of Kabbout: the game and its API, with the rules engine reached through the bridge.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4.1",
        "ext-json": "*",
        "symfony/http-client": "8.1.*"
    },
    "autoload": {
        "psr-4": {
            "Kabbout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kabbout\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.5"
    }
}
